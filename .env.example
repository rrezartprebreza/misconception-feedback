# Copy to .env and fill in. .env is ignored by git. No spaces around "=", no "export", no quotes.
# Run with: mvn -Popenai spring-boot:run

# Groq (free plan with rate limits)
OPENAI_BASE_URL=https://api.groq.com/openai
OPENAI_API_KEY=put_your_key_here
OPENAI_MODEL=openai/gpt-oss-20b
# Automatic fallback is for trying the tool only. Leave it off for a study: the model must stay fixed.
# LLM_FALLBACK_MODELS=openai/gpt-oss-120b

# Other OpenAI-compatible services (check the provider's docs for the current address and model names):
# Gemini:      OPENAI_BASE_URL=https://generativelanguage.googleapis.com
#              OPENAI_COMPLETIONS_PATH=/v1beta/openai/chat/completions
# OpenRouter:  OPENAI_BASE_URL=https://openrouter.ai/api

# Local Ollama instead (run with: mvn spring-boot:run)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5-coder:7b

# Instructor token for /label.html (collecting and labelling answers). Pages are off when empty.
COLLECT_ADMIN_TOKEN=choose-a-long-secret

# Only these IDs may submit on /collect.html (keeps names and student numbers out of the data).
# Ranges like S01..S60 are allowed. Leave empty to accept any ID.
# COLLECT_PARTICIPANT_IDS=S01..S60
